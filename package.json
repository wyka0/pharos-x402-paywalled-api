{
  "name": "pharos-x402-paywalled-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reviewer-ready x402 pay-per-request API, self-hosted facilitator, and payment client on Pharos Atlantic Testnet.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start:facilitator": "tsx src/facilitator/server.ts",
    "start:api": "tsx src/resource/server.ts",
    "dev:facilitator": "tsx watch src/facilitator/server.ts",
    "dev:api": "tsx watch src/resource/server.ts",
    "demo": "tsx src/client/demo.ts",
    "demo:local": "tsx scripts/local-demo.ts",
    "verify:network": "tsx scripts/verify-network.ts",
    "ui:install": "npm --prefix web install",
    "ui:dev": "npm --prefix web run dev",
    "ui:build": "npm --prefix web run build",
    "ui:start": "npm --prefix web run start",
    "ui:lint": "npm --prefix web run lint",
    "ui:typecheck": "npm --prefix web run typecheck",
    "check:ui": "npm run ui:typecheck && npm run ui:lint && npm run ui:build",
    "start:facilitator:prod": "node dist/src/facilitator/server.js",
    "start:api:prod": "node dist/src/resource/server.js"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "viem": "2.57.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
