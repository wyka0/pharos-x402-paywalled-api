# ============================================================================
# Pharos x402 paywalled API - example configuration
# Copy to .env (ignored by Git) and replace every placeholder.
# NEVER put a real private key in this file or in Git.
# ============================================================================

# --- Resource API (seller) -------------------------------------------------
# Receiving address for payments. Replace with your own testnet address.
PAY_TO_ADDRESS=0xYOUR_PAY_TO_ADDRESS
# Local default. Railway injects its own PORT into each service and the API
# reads it directly.
PORT=4021
TRUST_PROXY=false
# Base URL of the facilitator service. Use https:// in a public deployment.
FACILITATOR_URL=http://127.0.0.1:4022
FACILITATOR_TIMEOUT_MS=30000

# --- Facilitator (settler) -------------------------------------------------
# Local override. On Railway, leave this unset so the injected PORT is used;
# when both are set, FACILITATOR_PORT wins.
FACILITATOR_PORT=4022
RPC_URL=https://atlantic.dplabs-internal.com
FACILITATOR_CONFIRMATION_TIMEOUT_MS=60000

# Provide exactly one facilitator key source. Use a dedicated testnet wallet.
FACILITATOR_PRIVATE_KEY=
# FACILITATOR_PRIVATE_KEY_FILE=C:/absolute/path/outside/the/repo/facilitator.key

# --- Payment client (buyer) ------------------------------------------------
# Must be a DIFFERENT wallet from the facilitator signer.
PAYER_PRIVATE_KEY=
# PAYER_PRIVATE_KEY_FILE=C:/absolute/path/outside/the/repo/payer.key
API_URL=http://127.0.0.1:4021
DEMO_ROUTE=/data

# The demo refuses to sign or broadcast unless this is exactly YES.
LIVE_PAYMENT_APPROVED=NO

# --- Optional gated UI payment demo ---------------------------------------
# When enabled, the Express API can run the existing payment client for the
# web UI. It requires BOTH opt-ins, a server-side payer key, and the manual
# token below (entered in the browser dialog). Keep this OFF by default.
PAYMENT_DEMO_ENABLED=NO
PAYMENT_DEMO_APPROVAL_TOKEN=
# Target used by the API to call its own paid routes (inside the same host).
PAYMENT_DEMO_API_URL=http://127.0.0.1:4021

# --- Network guards (optional, but must match if set) ----------------------
NETWORK=eip155:688689
CHAIN_ID=688689
USDC_ADDRESS=0xcfC8330f4BCAB529c625D12781b1C19466A9Fc8B
USDC_DECIMALS=6
USDC_NAME=USDC
USDC_VERSION=2
