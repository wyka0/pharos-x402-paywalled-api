# ============================================================================
# MediumPayments web UI - server-side proxy origins
# Copy to web/.env.local (ignored by Git). These are NOT browser variables.
# Do not add private keys here: the browser must never receive signing material.
# ============================================================================

# Existing Express resource API (local default)
API_ORIGIN=http://127.0.0.1:4021

# Existing self-hosted facilitator (local default)
FACILITATOR_ORIGIN=http://127.0.0.1:4022
